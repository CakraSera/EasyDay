{
  "name": "@easyday/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "db:up": "tsx scripts/dev-db.ts up",
    "db:down": "tsx scripts/dev-db.ts down",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anvia/client": "1.1.2",
    "@anvia/core": "1.1.2",
    "@anvia/openai": "1.1.2",
    "@anvia/server": "1.1.2",
    "@hono/node-server": "^1.19.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "dotenv": "^17.4.2",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "embedded-postgres": "18.4.0-beta.17",
    "prisma": "7.10.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.2"
  }
}
